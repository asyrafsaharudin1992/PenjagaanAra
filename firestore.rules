rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - role: string (Doctor, Admin, Superadmin) (required)
    //   - permissions: list (required)
    //   - createdAt: string (ISO date)
    //
    // Collection: patients
    // Document ID: {patientId}
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - phone: string (required)
    //   - email: string
    //   - dateOfBirth: string
    //
    // Collection: cases
    // Document ID: {caseId}
    // Fields:
    //   - id: string (required)
    //   - patientName: string (required)
    //   - branch: string (Kajang, Seri Kembangan) (required)
    //   - diagnosis: string (required)
    //   - lastVisitDate: string
    //   - nextFollowUpDate: string (required)
    //   - doctorInCharge: string (required)
    //   - remarks: string
    //   - followUpDoneBy: string
    //   - followUpTag: string (required)
    //   - createdAt: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email == "atikah.abdrahman@gmail.com" ||
          request.auth.token.email == "operation@hsohealthcare.com" ||
          request.auth.token.email == "admin@hsohealthcare.com" ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Superadmin')
        );
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          isSuperadmin() || 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
        );
    }

    function isDoctor() {
      return isAuthenticated() && 
        (
          isAdmin() || 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Doctor')
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'permissions']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['Doctor', 'Admin', 'Superadmin'] &&
             (!('branch' in data) || data.branch in ['Kajang', 'Seri Kembangan']) &&
             data.permissions is list;
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'branch', 'tag', 'createdAt']) &&
             data.id is string &&
             data.name is string &&
             data.phone is string &&
             data.branch in ['Kajang', 'Seri Kembangan'] &&
             data.tag is string &&
             data.createdAt is string &&
             (!('patientId' in data) || data.patientId is string) &&
             (!('createdByEmail' in data) || data.createdByEmail is string) &&
             (!('createdByUid' in data) || data.createdByUid is string);
    }

    function isValidCase(data) {
      return data.keys().hasAll(['id', 'patientId', 'patientName', 'branch', 'diagnosis', 'doctorInCharge', 'followUpTag']) &&
             data.id is string &&
             data.patientId is string &&
             data.patientName is string &&
             data.branch in ['Kajang', 'Seri Kembangan'] &&
             data.diagnosis is string &&
             data.doctorInCharge is string &&
             data.followUpTag is string &&
             data.followUpTag.size() > 0 &&
             data.followUpTag.size() < 100 &&
             (!('createdByEmail' in data) || data.createdByEmail is string) &&
             (!('createdByUid' in data) || data.createdByUid is string) &&
             (!('patientPhone' in data) || data.patientPhone is string) &&
             (!('appointmentDate' in data) || data.appointmentDate is string);
    }

    function isValidNote(data) {
      return data.keys().hasAll(['patientNames', 'remarks', 'branch', 'createdByEmail']) &&
             data.patientNames is string && data.patientNames.size() > 0 && data.patientNames.size() < 1000 &&
             data.remarks is string && data.remarks.size() > 0 && data.remarks.size() < 5000 &&
             data.branch in ['Kajang', 'Seri Kembangan'] &&
             data.createdByEmail is string && data.createdByEmail.size() < 200;
    }

    function userHasBranchAccess(branch) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.branch == branch || userData.role == 'Superadmin';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(uid) || isSuperadmin()) && isValidUser(request.resource.data);
      allow update: if (isOwner(uid) || isSuperadmin()) && isValidUser(request.resource.data);
      allow delete: if isSuperadmin();
    }

    match /patients/{patientId} {
      allow read: if isDoctor();
      allow create, update: if isAdmin() && isValidPatient(request.resource.data);
      allow delete: if isDoctor();
    }

    match /cases/{caseId} {
      allow list: if isDoctor(); // Allow list/count for stats, security is on individual 'get' and specific queries
      allow get: if isDoctor() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userHasBranchAccess(resource.data.branch)));
      allow create: if isDoctor() && isValidCase(request.resource.data) && 
                    (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userHasBranchAccess(request.resource.data.branch))) &&
                    ('createdByEmail' in request.resource.data) && request.resource.data.createdByEmail == request.auth.token.email &&
                    ('createdByUid' in request.resource.data) && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isDoctor() && isValidCase(request.resource.data) && 
                    (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userHasBranchAccess(resource.data.branch))) &&
                    (isSuperadmin() || (('createdByEmail' in resource.data) && resource.data.createdByEmail == request.auth.token.email)) &&
                    (!('createdByEmail' in request.resource.data) || request.resource.data.createdByEmail == resource.data.createdByEmail) &&
                    (!('createdByUid' in request.resource.data) || request.resource.data.createdByUid == resource.data.createdByUid);
      allow delete: if isSuperadmin();
    }

    match /wellness_updates/{updateId} {
      allow create, update: if true;
      allow read: if isDoctor();
      allow delete: if isAdmin();
    }

    match /public_followups/{requestId} {
      allow create: if true;
      allow read, update, delete: if isDoctor();
    }

    match /todo/{todoId} {
      allow create: if true;
      allow read, update, delete: if isDoctor() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userHasBranchAccess(resource.data.branch)));
    }

    match /branch_notes/{noteId} {
      allow read: if isDoctor() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userHasBranchAccess(resource.data.branch)));
      allow create: if isDoctor() && isValidNote(request.resource.data) &&
                    (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userHasBranchAccess(request.resource.data.branch)));
      allow delete: if isDoctor() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userHasBranchAccess(resource.data.branch)));
    }

    match /tags/{tagId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isDoctor();
      allow delete: if isSuperadmin();
    }

    match /branches/{branchId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isSuperadmin();
      allow delete: if isSuperadmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
